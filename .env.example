# Host port for `docker compose up`.
PORT=3000

# Set to true only behind a reverse proxy.
# LinkDrop then trusts the last X-Forwarded-For hop and X-Forwarded-Proto.
TRUST_PROXY=false

# Public origin used in pairing links, e.g. https://drop.example.com. Empty uses the request host.
PUBLIC_URL=

# Optional tuning (defaults shown). compose.yaml passes these through.
# SESSION_TTL=30m
# PAIRING_TTL=2m
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW=1m
# RATE_LIMIT_MAX_KEYS=10000
# MAX_ITEMS_PER_SESSION=100
# LOG_LEVEL=info
