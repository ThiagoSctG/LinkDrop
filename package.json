{
  "name": "linkdrop",
  "version": "0.2.0",
  "description": "Temporary link and text sharing between a screen and a phone paired by QR code.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThiagoSctG/LinkDrop.git"
  },
  "bugs": {
    "url": "https://github.com/ThiagoSctG/LinkDrop/issues"
  },
  "homepage": "https://github.com/ThiagoSctG/LinkDrop#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:all": "npm run build && go build -trimpath ./cmd/linkdrop",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write web/src web/public vite.config.ts vitest.config.ts",
    "format:check": "prettier --check web/src web/public vite.config.ts vitest.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "preact": "^11.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
